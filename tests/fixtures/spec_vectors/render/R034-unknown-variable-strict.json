{
  "schema": "agenomic.conformance_vector/v1",
  "suite": "render",
  "id": "R034",
  "intent": "an undeclared input variable is refused in strict mode",
  "consumers": [
    "rust-cloud",
    "rust-cli",
    "python",
    "typescript"
  ],
  "input": {
    "method": "text",
    "content": {
      "schema": "agenomic.prompt_content/v1",
      "template_format": "agenomic-fstring/v1",
      "renderer_version": "1",
      "kind": "text",
      "body": "Hello {name}",
      "variables": {
        "name": {
          "type": "string",
          "required": true
        }
      },
      "partials": {},
      "output_contract": null,
      "fragments": {}
    },
    "fragments": {},
    "variables": {
      "name": "Ada",
      "zzz": "1"
    },
    "options": {
      "strict": true,
      "history": null,
      "allow_duplicate_system": false,
      "secret_policy": "off"
    }
  },
  "expected": {
    "ok": false,
    "error": {
      "code": "prompt_render_error",
      "item": {
        "code": "unknown_variable",
        "variable": "zzz"
      }
    }
  }
}
